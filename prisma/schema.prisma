datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model InvitationRequest {
  id        String   @id @default(uuid())
  email     String   @unique
  source    String   @default("waitlist")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
